<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Placed at the repository root rather than under src/ so that it also covers the test
    project, which lives outside src/ and restores Lithnet.ResourceManagement.Client
    transitively through its project reference to the server.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="LithnetPrivatePackages" value="https://pkgs.dev.azure.com/lithnet/_packaging/LithnetPrivatePackages/nuget/v3/index.json" />
  </packageSources>
</configuration>
